# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Secrets / local credentials (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
kaggle.json
.kaggle/
secrets/
*.token

# --- OS / IDE ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# --- Large local artifacts ---
*.zip
*.gguf
*.bin
*.pt
*.onnx

# Competition package may ship a small tool wheel — keep it
!data/kaggle_evaluation/deps/*.whl

# --- Runtime / local outputs ---
*.log
.playwright-mcp/
.review_*/
notebooks/submit_kernel/output/
strix_runs/
.lmstudio/
models/

# Scratch dumps / local runs (not part of the public archive)
results/
tmp/
tmp_*/
tmp_kout/
*.bak
notebooks/**/*.bak

# Agent session scratch
.hermes/
.workbuddy-ai/
.grok/

# Windows reserved-name leftovers
NUL
nul
null
